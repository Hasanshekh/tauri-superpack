{
  "name": "tauri-superpack",
  "version": "0.1.0",
  "private": true,
  "description": "Next-generation Tauri v2 ecosystem plugins to surpass Electron",
  "workspaces": [
    "crates/*/guest-js",
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
