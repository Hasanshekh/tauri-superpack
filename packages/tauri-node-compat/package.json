{
  "name": "tauri-node-compat",
  "version": "0.1.0",
  "description": "Drop-in Node.js API shims (fs, path, child_process, os, events) for Tauri v2",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./fs": {
      "types": "./dist/fs.d.ts",
      "import": "./dist/fs.mjs",
      "require": "./dist/fs.js"
    },
    "./path": {
      "types": "./dist/path.d.ts",
      "import": "./dist/path.mjs",
      "require": "./dist/path.js"
    },
    "./child_process": {
      "types": "./dist/child_process.d.ts",
      "import": "./dist/child_process.mjs",
      "require": "./dist/child_process.js"
    },
    "./os": {
      "types": "./dist/os.d.ts",
      "import": "./dist/os.mjs",
      "require": "./dist/os.js"
    },
    "./events": {
      "types": "./dist/events.d.ts",
      "import": "./dist/events.mjs",
      "require": "./dist/events.js"
    }
  },
  "scripts": {
    "build": "tsc --emitDeclarationOnly && tsup src/index.ts src/fs.ts src/path.ts src/child_process.ts src/os.ts src/events.ts --format cjs,esm --dts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0"
  }
}
